{
  "name": "editor-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "postinstall": "node scripts/fix-turbo-perms.mjs",
    "dev": "turbo run dev",
    "build": "node scripts/fix-turbo-perms.mjs && turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@editor/config/prettier",
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  }
}
