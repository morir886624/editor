{
  "name": "@editor/mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "sync": "cap sync",
    "mobile:android": "pnpm build && cap sync android && cap open android",
    "mobile:ios": "pnpm build && cap sync ios && cap open ios",
    "apk": "pnpm build && cap sync android && node scripts/gradle.mjs assembleDebug",
    "apk:release": "pnpm build && cap sync android && node scripts/gradle.mjs assembleRelease",
    "aab": "pnpm build && cap sync android && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "prettier": "@editor/config/prettier",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@editor/config": "workspace:*",
    "@editor/web": "workspace:*",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
