# Apache config for the built video editor (Hostinger / shared hosting).
# Vite copies everything in public/ verbatim to the root of dist/, so this
# file ships as public_html/.htaccess when you upload the contents of dist/.

# --- Index / 403 fix -------------------------------------------------------
# Without an explicit index Apache forbids directory listing and returns 403
# at the site root. Force index.html and never expose a listing.
DirectoryIndex index.html
Options -Indexes

# --- SPA fallback ----------------------------------------------------------
# Single-page app: route every non-file request back to index.html so deep
# links / refreshes don't 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Correct MIME types ----------------------------------------------------
# FFmpeg.wasm fails to instantiate if the .wasm is served as text/plain.
<IfModule mod_mime.c>
  AddType application/wasm            .wasm
  AddType font/woff2                  .woff2
  AddType image/svg+xml               .svg
  AddType application/manifest+json   .webmanifest
</IfModule>

# IMPORTANT: do NOT add Cross-Origin-Embedder-Policy / -Opener-Policy here.
# Cross-origin isolation would break FFmpeg's unpkg CDN fallback (see CLAUDE.md).

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml
  # .wasm is already large + not very compressible; skip to save CPU.
</IfModule>

# --- Caching ---------------------------------------------------------------
# Vite fingerprints /assets/* so they can be cached forever. index.html must
# stay uncached so new deploys are picked up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm     "access plus 1 year"
  ExpiresByType text/css             "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived, immutable hashed assets.
  <FilesMatch "\.(js|css|wasm|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the HTML entrypoint.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
